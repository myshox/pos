# 多台裝置同步（選填）。未設定則僅使用本機儲存，不同步。
# 設定方式見 docs/多台裝置同步設定.md
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_STORE_KEY=

# TapPay 前端 SDK（可公開的應用識別資料）
VITE_TAPPAY_APP_ID=
VITE_TAPPAY_APP_KEY=
VITE_TAPPAY_SERVER_TYPE=sandbox
# 完整 TPDirect → prime → 後端成功流程完成前必須維持 false
VITE_TAPPAY_CHECKOUT_ENABLED=false

# 以下只可設定在伺服器端，禁止加上 VITE_ 前綴：
TAPPAY_PARTNER_KEY=
TAPPAY_MERCHANT_ID=
